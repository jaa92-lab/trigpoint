# Copy this file to .env and fill in the values yourself. Never commit .env.
# The same names go into GitHub: Settings > Secrets and variables > Actions.

# Bot account token from https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=

# Key from Metaculus's donated-credit form (or your own OpenRouter key)
OPENROUTER_API_KEY=

# Free AskNews access for tournament bot makers. Fill in either the single
# API key from https://my.asknews.app/en/settings/api-credentials, or the
# older client ID + secret pair.
ASKNEWS_API_KEY=
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=
